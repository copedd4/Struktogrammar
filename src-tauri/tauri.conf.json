{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Struktogrammer",
  "version": "0.1.0",
  "identifier": "com.struktogrammer.ch",
  "build": {
  "frontendDist": "../dist",
  "devUrl": "http://localhost:8080",
  "beforeBuildCommand": "bun run build:tauri",
  "beforeDevCommand": "bun run dev"
},
  "app": {
    "windows": [
      {
        "title": "Struktogrammer",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
	"dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
