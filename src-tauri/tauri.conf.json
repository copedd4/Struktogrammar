{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Struktogramm Editor",
  "version": "0.1.0",
  "identifier": "io.strukto.editor",
  "build": {
    "beforeDevCommand": "bun run desktop:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run desktop:build",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Struktogramm Editor",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "stkg"
        ],
        "name": "Struktogramm project",
        "description": "Struktogramm (.stkg) diagram",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ]
  }
}