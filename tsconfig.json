{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["js/**/*.js"],
  "exclude": ["node_modules", "tests"]
}
